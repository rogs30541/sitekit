# SiteKit api（NestJS）— 以 repo 根目錄為 build context
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY mcp/package.json mcp/
RUN npm ci --no-audit --no-fund
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm run build -w @sitekit/shared \
 && npm run db:generate -w @sitekit/api \
 && npm run build -w @sitekit/api \
 && npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production APP_ENV=production PORT=4000
COPY --from=build /app ./
EXPOSE 4000
# 啟動前套用遷移（冪等），再起 api
CMD ["sh", "-c", "npm run db:migrate -w @sitekit/api && node apps/api/dist/main.js"]
