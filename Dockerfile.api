# SiteKit api（NestJS）— 以 repo 根目錄為 build context；與 Zeabur 服務設定中的自訂 Dockerfile 同步
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/edge/package.json apps/edge/
COPY apps/worker/package.json apps/worker/
COPY mcp/package.json mcp/
COPY plugins/webhook/package.json plugins/webhook/
RUN npm ci --no-audit --no-fund
COPY packages/shared packages/shared
COPY packages/core packages/core
COPY packages/db packages/db
COPY apps/api apps/api
COPY plugins plugins
COPY sitekit.config.mjs ./
# 不 prune：啟動時的 prisma migrate deploy 需要 prisma CLI（devDependency）
RUN npm run build -w @sitekit/shared && npm run build -w @sitekit/db && npm run db:generate -w @sitekit/api && npm run build -w @sitekit/core && npm run build -w @sitekit/api

FROM node:22-alpine
WORKDIR /app
# Zeabur 預設注入 PORT=8080，與 EXPOSE 對齊
ENV NODE_ENV=production APP_ENV=production PORT=8080
COPY --from=build /app ./
EXPOSE 8080
# 啟動前套用遷移（冪等），再起 api
CMD ["sh", "-c", "npm run db:migrate -w @sitekit/api && node apps/api/dist/main.js"]
