{
  "name": "@sitekit/server",
  "version": "0.30.0",
  "private": true,
  "description": "SiteKit 單體殼：一個 Node 程序同時跑 API 與前台，預設 SQLite；sitekit start 即開站",
  "main": "dist/main.js",
  "bin": {
    "sitekit": "bin/sitekit.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node bin/sitekit.mjs start"
  },
  "dependencies": {
    "@sitekit/api": "*",
    "@sitekit/db": "*",
    "@sitekit/web": "*",
    "next": "^15.5.0",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
