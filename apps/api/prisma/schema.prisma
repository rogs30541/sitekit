// SiteKit 核心資料模型（依 docs/全新網站規劃.md 第 03 節）
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  superadmin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ProductType {
  physical
  course
  credit_pack
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
  canceled
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  canceled
}

enum ContentStatus {
  draft
  published
  archived
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String?
  displayName     String?
  role            Role              @default(user)
  status          UserStatus        @default(active)
  membershipTier  String?
  allowedFeatures String[]          @default([])
  creditBalance   Int               @default(0)
  creditReserved  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  identities      Identity[]
  sessions        Session[]
  orders          Order[]
  entitlements    Entitlement[]
  ledger          CreditLedger[]
  jobs            AiJob[]
  progress        ChapterProgress[]
  apiKeys         UserApiKey[]

  @@map("users")
}

/// 伺服器端 session：cookie 只存 id，權限以 DB 為準，登出即失效
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Identity {
  id          String @id @default(cuid())
  userId      String
  provider    String
  providerUid String
  user        User   @relation(fields: [userId], references: [id])

  @@unique([provider, providerUid])
  @@map("identities")
}

/// 商品與課程共用 SKU 模型；type=course 時對應一筆 Course
model Product {
  id           String        @id @default(cuid())
  type         ProductType
  sku          String        @unique
  name         String
  description  String?
  coverUrl     String?
  price        Int
  isActive     Boolean       @default(true)
  course       Course?
  items        OrderItem[]
  entitlements Entitlement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("products")
}

/// 課程：封面影片／試看影片為銷售頁公開素材；觀看期限決定購買後授權到期
model Course {
  id                   String    @id @default(cuid())
  productId            String    @unique
  slug                 String    @unique
  summary              String?
  isPublished          Boolean   @default(false)
  coverVideoProvider   String?
  coverVideoId         String?
  previewVideoProvider String?
  previewVideoId       String?
  accessMode           String    @default("unlimited")
  accessDays           Int?
  accessUntil          DateTime?
  product              Product   @relation(fields: [productId], references: [id])
  chapters             Chapter[]

  @@map("courses")
}

/// 章節：parentId 為 null 是根層（可當「單元」容器），有 parentId 是子章節；order 為同層排序
model Chapter {
  id              String            @id @default(cuid())
  courseId        String
  parentId        String?
  order           Int
  title           String
  body            String?
  videoProvider   String            @default("youtube")
  videoProviderId String?
  durationSec     Int?
  isPreview       Boolean           @default(false)
  isPublished     Boolean           @default(true)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent          Chapter?          @relation("ChapterTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Chapter[]         @relation("ChapterTree")
  progress        ChapterProgress[]

  @@index([courseId, parentId, order])
  @@map("chapters")
}

/// 觀看進度：每人每章一筆；completedAt 有值＝已完成
model ChapterProgress {
  id          String    @id @default(cuid())
  userId      String
  chapterId   String
  positionSec Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("chapter_progress")
}

/// 影片庫：後台匯入的 YouTube（或其他來源）影片，章節從這裡選
model VideoAsset {
  id           String   @id @default(cuid())
  provider     String
  externalId   String
  title        String
  thumbnailUrl String?
  author       String?
  durationSec  Int?
  createdAt    DateTime @default(now())

  @@unique([provider, externalId])
  @@map("video_assets")
}

/// 訂單狀態機：pending → paid | failed | canceled；paid → refunded。授權只在 markPaid 寫入。
model Order {
  id              String         @id @default(cuid())
  merchantOrderNo String         @unique
  userId          String
  status          OrderStatus    @default(pending)
  amount          Int
  provider        String?
  providerTradeNo String?
  paymentType     String?
  paidAt          DateTime?
  virtualAccount  String?
  expireAt        DateTime?
  refundStatus    String?
  refundReason    String?
  refundedAt      DateTime?
  note            String?
  user            User           @relation(fields: [userId], references: [id])
  items           OrderItem[]
  events          PaymentEvent[]
  invoices        Invoice[]
  entitlements    Entitlement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  qty       Int     @default(1)
  unitPrice Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

/// 金流回呼原始紀錄：驗章通過才寫；同 tradeNo+type 冪等
model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  provider  String
  type      String
  tradeNo   String?
  payload   Json
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("payment_events")
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String
  provider  String
  number    String?
  status    String
  amount    Int
  payload   Json?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("invoices")
}

/// 課程／商品授權：唯一可寫入者是後端（金流回呼、免費訂單、管理員手動）；expiresAt 由課程觀看期限決定
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  source    String    @default("purchase")
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@map("entitlements")
}

model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  type         String
  amount       Int
  balanceAfter Int
  jobId        String?
  reason       String?
  createdBy    String?
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@map("credit_ledger")
}

/// AI 生成任務：點數在建立時保留、完成結算、失敗釋放；BYOK 不扣點
model AiJob {
  id          String      @id @default(cuid())
  userId      String
  kind        String      @default("image")
  status      JobStatus   @default(queued)
  templateId  String?
  prompt      String
  inputs      Json?
  quality     String      @default("standard")
  size        String      @default("1024x1024")
  provider    String?
  byok        Boolean     @default(false)
  costPoints  Int         @default(0)
  costTwd     Decimal?    @db.Decimal(10, 4)
  resultUrl   String?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  user        User        @relation(fields: [userId], references: [id])
  template    AiTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_jobs")
}

/// AI 模板：systemPrompt 只在後台回傳；公開端只回名稱、欄位與點數
model AiTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  category       String   @default("general")
  description    String?
  coverUrl       String?
  systemPrompt   String
  inputFields    Json     @default("[]")
  defaultSize    String   @default("1024x1024")
  costPoints     Int      @default(5)
  highCostPoints Int      @default(15)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(100)
  jobs           AiJob[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("ai_templates")
}

/// BYOK：用戶自帶金鑰（AES-256-GCM 加密存放，只回 last4）
model UserApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  encrypted String
  last4     String
  enabled   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@map("user_api_keys")
}

/// 正規化內容模型（canonical content）：外站搬運與自建內容共用
model Content {
  id           String        @id @default(cuid())
  source       String
  externalId   String
  type         String        @default("post")
  title        String
  slug         String        @unique
  body         String?
  excerpt      String?
  coverUrl     String?
  author       String?
  tags         String[]      @default([])
  canonicalUrl String?
  originalUrl  String?
  status       ContentStatus @default(draft)
  publishedAt  DateTime?
  raw          Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([source, externalId])
  @@index([status, publishedAt])
  @@map("contents")
}

model Redirect {
  id       String  @id @default(cuid())
  fromPath String  @unique
  toPath   String
  code     Int     @default(301)
  source   String?

  @@map("redirects")
}

model Setting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  params    Json?
  ok        Boolean
  error     String?
  result    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
