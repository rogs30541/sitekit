// SiteKit 核心資料模型（依 docs/全新網站規劃.md 第 03 節）
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  superadmin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ProductType {
  physical
  course
  credit_pack
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
  canceled
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  canceled
}

enum ContentStatus {
  draft
  published
  archived
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  displayName     String?
  role            Role           @default(user)
  status          UserStatus     @default(active)
  membershipTier  String?
  allowedFeatures String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  identities      Identity[]
  sessions        Session[]
  orders          Order[]
  entitlements    Entitlement[]
  ledger          CreditLedger[]
  jobs            AiJob[]

  @@map("users")
}

/// 伺服器端 session：cookie 只存 id，權限以 DB 為準，登出即失效
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Identity {
  id          String @id @default(cuid())
  userId      String
  provider    String
  providerUid String
  user        User   @relation(fields: [userId], references: [id])

  @@unique([provider, providerUid])
  @@map("identities")
}

/// 商品與課程共用 SKU 模型；type=course 時對應一筆 Course
model Product {
  id           String        @id @default(cuid())
  type         ProductType
  sku          String        @unique
  name         String
  description  String?
  coverUrl     String?
  price        Int
  isActive     Boolean       @default(true)
  course       Course?
  items        OrderItem[]
  entitlements Entitlement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("products")
}

model Course {
  id          String    @id @default(cuid())
  productId   String    @unique
  slug        String    @unique
  summary     String?
  isPublished Boolean   @default(false)
  product     Product   @relation(fields: [productId], references: [id])
  chapters    Chapter[]

  @@map("courses")
}

model Chapter {
  id              String  @id @default(cuid())
  courseId        String
  order           Int
  title           String
  videoProvider   String  @default("youtube")
  videoProviderId String?
  durationSec     Int?
  isPreview       Boolean @default(false)
  course          Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
  @@map("chapters")
}

/// 影片庫：後台匯入的 YouTube（或其他來源）影片，章節從這裡選
model VideoAsset {
  id           String   @id @default(cuid())
  provider     String
  externalId   String
  title        String
  thumbnailUrl String?
  author       String?
  durationSec  Int?
  createdAt    DateTime @default(now())

  @@unique([provider, externalId])
  @@map("video_assets")
}

/// 訂單狀態機：pending → paid | failed | canceled；paid → refunded。授權只在 markPaid 寫入。
model Order {
  id              String         @id @default(cuid())
  merchantOrderNo String         @unique
  userId          String
  status          OrderStatus    @default(pending)
  amount          Int
  provider        String?
  providerTradeNo String?
  paymentType     String?
  paidAt          DateTime?
  virtualAccount  String?
  expireAt        DateTime?
  refundStatus    String?
  refundReason    String?
  refundedAt      DateTime?
  note            String?
  user            User           @relation(fields: [userId], references: [id])
  items           OrderItem[]
  events          PaymentEvent[]
  invoices        Invoice[]
  entitlements    Entitlement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  qty       Int     @default(1)
  unitPrice Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

/// 金流回呼原始紀錄：驗章通過才寫；同 tradeNo+type 冪等
model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  provider  String
  type      String
  tradeNo   String?
  payload   Json
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("payment_events")
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String
  provider  String
  number    String?
  status    String
  amount    Int
  payload   Json?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("invoices")
}

/// 課程／商品授權：唯一可寫入者是後端（金流回呼、免費訂單、管理員手動）
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  source    String    @default("purchase")
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@map("entitlements")
}

model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  type         String
  amount       Int
  balanceAfter Int
  jobId        String?
  reason       String?
  createdBy    String?
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@map("credit_ledger")
}

model AiJob {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  status    JobStatus @default(queued)
  provider  String?
  costTwd   Decimal?  @db.Decimal(10, 4)
  resultUrl String?
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("ai_jobs")
}

/// 正規化內容模型（canonical content）：外站搬運與自建內容共用
model Content {
  id           String        @id @default(cuid())
  source       String
  externalId   String
  type         String        @default("post")
  title        String
  slug         String        @unique
  body         String?
  excerpt      String?
  coverUrl     String?
  author       String?
  tags         String[]      @default([])
  canonicalUrl String?
  originalUrl  String?
  status       ContentStatus @default(draft)
  publishedAt  DateTime?
  raw          Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([source, externalId])
  @@index([status, publishedAt])
  @@map("contents")
}

model Redirect {
  id       String  @id @default(cuid())
  fromPath String  @unique
  toPath   String
  code     Int     @default(301)
  source   String?

  @@map("redirects")
}

model Setting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  params    Json?
  ok        Boolean
  error     String?
  result    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
