APP_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://sitekit:sitekit@localhost:5432/sitekit
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production
# MCP 路徑的操作者 token；留空＝整條 /api/ops 路徑關閉
OPS_TOKEN=

# ===== 以下皆可改由後台「系統設定」寫入 settings 表（DB 優先、env 備援）=====
# 金流：none | mock（僅非 production）| newebpay | payuni | ecpay | linepay | pchomepay
PAYMENT_PROVIDER=
# 結帳頁同時提供多種付款方式（逗號清單、第一個為預設）；空＝只用 PAYMENT_PROVIDER
PAYMENT_METHODS=
# 各家 *_TEST_MODE 預設 true（沙箱／測試環境）；上正式改 false
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_TEST_MODE=
# 明確指定藍新閘道網址（空＝依 TEST_MODE：測試 ccore／正式 core）
NEWEBPAY_API_URL=
PAYUNI_MERCHANT_ID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
PAYUNI_TEST_MODE=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_TEST_MODE=
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_TEST_MODE=
PCHOMEPAY_APP_ID=
PCHOMEPAY_APP_SECRET=
PCHOMEPAY_TEST_MODE=
# 電商：運費（元）、免運門檻（元，空＝不免運）、未付款訂單逾期小時數
SHIPPING_FEE=
SHIPPING_FREE_OVER=
ORDER_EXPIRE_HOURS=
# 物件儲存：local（STORAGE_DIR）| s3（Cloudflare R2／S3 相容；SigV4 免 SDK）
STORAGE_DRIVER=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# 後台自助註冊白名單（Email 驗證碼；第一位管理員不需白名單）
ADMIN_REGISTER_ALLOWLIST=
# 第三方登入（OAuth 2.0 授權碼；Redirect URI＝<site.url>/api/auth/oauth/<google|line>/callback）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 通知：Email provider log | resend；LINE Messaging API 推播給管理員
NOTIFY_EMAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
MAIL_ADMIN_TO=
LINE_CHANNEL_TOKEN=
LINE_ADMIN_USER_ID=
# 物流：LOGISTICS_PROVIDER none|ecpay；LOGISTICS_METHODS 逗號清單（manual,UNIMARTC2C,FAMIC2C,HILIFEC2C,OKMARTC2C,TCAT,ECAN）；LOGISTICS_FEES 例 UNIMARTC2C=60,TCAT=120
LOGISTICS_PROVIDER=
LOGISTICS_METHODS=manual
LOGISTICS_FEES=
LOGISTICS_SENDER_NAME=
LOGISTICS_SENDER_PHONE=
LOGISTICS_SENDER_ZIP=
LOGISTICS_SENDER_ADDRESS=
ECPAY_LOGISTICS_MERCHANT_ID=
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=
ECPAY_LOGISTICS_TEST_MODE=
# 電子發票：INVOICE_PROVIDER none|ezpay|ecpay；INVOICE_ISSUE_TIMING paid|manual
INVOICE_PROVIDER=
INVOICE_ISSUE_TIMING=
EZPAY_TEST_MODE=
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=
ECPAY_INVOICE_TEST_MODE=
# 光貿（Amego）電子發票：測試公司統編 12345678 與文件公開的測試 App Key 即為測試環境
AMEGO_TAX_ID=
AMEGO_APP_KEY=
# ezPay 電子發票（EZPAY_ENABLED=true 才會開立）
EZPAY_ENABLED=
EZPAY_MERCHANT_ID=
EZPAY_HASH_KEY=
EZPAY_HASH_IV=
EZPAY_INVOICE_URL=
# Bunny Stream（影片簽章播放）
BUNNY_LIBRARY_ID=
BUNNY_SIGNING_KEY=

# 本機 E2E 可設 RATE_LIMIT=off 關閉限流（正式環境勿設）
RATE_LIMIT=
