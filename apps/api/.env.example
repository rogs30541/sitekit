APP_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://sitekit:sitekit@localhost:5432/sitekit
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production
# MCP 路徑的操作者 token；留空＝整條 /api/ops 路徑關閉
OPS_TOKEN=

# ===== 以下皆可改由後台「系統設定」寫入 settings 表（DB 優先、env 備援）=====
# 金流：none | mock（僅非 production）| newebpay | payuni | ecpay | linepay | pchomepay
PAYMENT_PROVIDER=
# 結帳頁同時提供多種付款方式（逗號清單、第一個為預設）；空＝只用 PAYMENT_PROVIDER
PAYMENT_METHODS=
# 各家 *_TEST_MODE 預設 true（沙箱／測試環境）；上正式改 false
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_TEST_MODE=
# 明確指定藍新閘道網址（空＝依 TEST_MODE：測試 ccore／正式 core）
NEWEBPAY_API_URL=
PAYUNI_MERCHANT_ID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
PAYUNI_TEST_MODE=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_TEST_MODE=
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_TEST_MODE=
PCHOMEPAY_APP_ID=
PCHOMEPAY_APP_SECRET=
PCHOMEPAY_TEST_MODE=
# ezPay 電子發票（EZPAY_ENABLED=true 才會開立）
EZPAY_ENABLED=
EZPAY_MERCHANT_ID=
EZPAY_HASH_KEY=
EZPAY_HASH_IV=
EZPAY_INVOICE_URL=
# Bunny Stream（影片簽章播放）
BUNNY_LIBRARY_ID=
BUNNY_SIGNING_KEY=
