APP_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://sitekit:sitekit@localhost:5432/sitekit
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production
# MCP 路徑的操作者 token；留空＝整條 /api/ops 路徑關閉
OPS_TOKEN=

# ===== 以下皆可改由後台「系統設定」寫入 settings 表（DB 優先、env 備援）=====
# 金流：none | mock（僅非 production）| newebpay
PAYMENT_PROVIDER=
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
# 測試 https://ccore.newebpay.com/MPG/mpg_gateway；正式 https://core.newebpay.com/MPG/mpg_gateway
NEWEBPAY_API_URL=
# ezPay 電子發票（EZPAY_ENABLED=true 才會開立）
EZPAY_ENABLED=
EZPAY_MERCHANT_ID=
EZPAY_HASH_KEY=
EZPAY_HASH_IV=
EZPAY_INVOICE_URL=
# Bunny Stream（影片簽章播放）
BUNNY_LIBRARY_ID=
BUNNY_SIGNING_KEY=
