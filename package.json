{
  "name": "sitekit",
  "private": true,
  "version": "0.19.0",
  "description": "AIGC創客架站套件（SiteKit）：電商開店／線上課程／品牌網站共用骨架，後台具 MCP 與 AI API 雙路徑",
  "workspaces": [
    "packages/*",
    "apps/*",
    "mcp"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @sitekit/web",
    "dev:api": "npm run dev -w @sitekit/api",
    "build": "npm run build -w @sitekit/shared && npm run build -w @sitekit/core && npm run build -w @sitekit/api && npm run build -w @sitekit/web",
    "build:shared": "npm run build -w @sitekit/shared",
    "build:core": "npm run build -w @sitekit/core",
    "build:api": "npm run build -w @sitekit/api",
    "build:web": "npm run build -w @sitekit/web",
    "db:generate": "npm run db:generate -w @sitekit/api",
    "db:migrate": "npm run db:migrate -w @sitekit/api",
    "mcp": "node mcp/server.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "db:seed": "npm run db:seed -w @sitekit/api",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "ci": "npm run build && npm run db:validate -w @sitekit/api",
    "test:e2e": "node tests/e2e/run.mjs",
    "dev:db:stop": "node scripts/dev-db.mjs stop",
    "dev:edge": "npm run dev -w @sitekit/edge",
    "edge:migrate:local": "npm run migrate:local -w @sitekit/edge",
    "edge:deploy": "npm run deploy -w @sitekit/edge",
    "build:edge": "npm run build -w @sitekit/edge"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
