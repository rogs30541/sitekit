# 必填：網域與 Postgres 密碼
DOMAIN=shop.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# 選填：站台公開網址（預設 https://$DOMAIN）；映像版本（預設 latest）；機密留空＝首次啟動自動產生存資料庫
#SITE_URL=https://shop.example.com
#SITEKIT_IMAGE=ghcr.io/rogs30541/sitekit:0.25.1
#SESSION_SECRET=
#OPS_TOKEN=
# 用 SQLite 免 Postgres：DATABASE_URL=file:/data/sitekit.db（並把 docker-compose.yml 的 postgres 服務與 depends_on 拿掉）
#DATABASE_URL=
